{
  "name": "dsh-harness-kit",
  "version": "0.3.3",
  "description": "Multi-agent engineering workflow for DeepSeek Harness: roles, flows, guards and workspace assets.",
  "private": false,
  "license": "MIT",
  "author": "leo",
  "type": "module",
  "homepage": "https://github.com/LaoLiang-agent/HarnessKit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaoLiang-agent/HarnessKit.git"
  },
  "bugs": {
    "url": "https://github.com/LaoLiang-agent/HarnessKit/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "workflow",
    "agents"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/sim.mjs",
    "pack:check": "node test/pack-check.mjs",
    "vendor:feishu": "node scripts/vendor-feishu.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "kernel/**",
    "packs/**",
    "locale/*.json",
    "icon.svg",
    "docs/DETAIL.md",
    "docs/DETAIL.en.md",
    "docs/assets/*.png",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {},
  "packageManager": "pnpm@11.14.0+sha512.66c1ac4c7d4762d6d7dde44c7f3e5a73591ed0a0806e751d4ed32d4f004f25b2285a906b1fd8a9e3e621df3b4e2858bf88e50e0cf626bedbe977fe434a5caf85",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "@larksuiteoapi/node-sdk": "^1.73.0"
  }
}
